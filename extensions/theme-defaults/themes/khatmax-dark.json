"tokenColors": [
{ "scope": ["comment", "punctuation.definition.comment", "string.comment"], "settings": { "foreground": "#475569" } },
{ "scope": ["constant.other.placeholder", "constant.character"], "settings": { "foreground": "#F87171" } },
{ "scope": ["constant", "entity.name.constant", "variable.other.constant", "variable.other.enummember", "variable.language", "entity"], "settings": { "foreground": "#67E8F9" } },
{ "scope": ["entity.name", "meta.export.default", "meta.definition.variable"], "settings": { "foreground": "#5EEAD4" } },
{ "scope": ["variable.parameter.function", "meta.jsx.children", "meta.block", "meta.tag.attributes", "entity.name.constant", "meta.object.member", "meta.embedded.expression"], "settings": { "foreground": "#CBD5E1" } },
{ "scope": "entity.name.function", "settings": { "foreground": "#A78BFA" } },
{ "scope": ["entity.name.tag", "support.class.component"], "settings": { "foreground": "#34D399" } },
{ "scope": "keyword", "settings": { "foreground": "#F472B6" } },
{ "scope": ["storage", "storage.type"], "settings": { "foreground": "#F472B6" } },
{ "scope": ["storage.modifier.package", "storage.modifier.import", "storage.type.java"], "settings": { "foreground": "#CBD5E1" } },
{ "scope": ["string", "string punctuation.section.embedded source"], "settings": { "foreground": "#6EE7B7" } },
{ "scope": "support", "settings": { "foreground": "#67E8F9" } },
{ "scope": "meta.property-name", "settings": { "foreground": "#67E8F9" } },
{ "scope": "variable", "settings": { "foreground": "#5EEAD4" } },
{ "scope": "variable.other", "settings": { "foreground": "#CBD5E1" } },
{ "scope": "invalid.broken", "settings": { "foreground": "#FCA5A5", "fontStyle": "italic" } },
{ "scope": "invalid.deprecated", "settings": { "foreground": "#FCA5A5", "fontStyle": "italic" } },
{ "scope": "invalid.illegal", "settings": { "foreground": "#FCA5A5", "fontStyle": "italic" } },
{ "scope": "invalid.unimplemented", "settings": { "foreground": "#FCA5A5", "fontStyle": "italic" } },
{ "scope": "message.error", "settings": { "foreground": "#FCA5A5" } },
{ "scope": "string variable", "settings": { "foreground": "#67E8F9" } },
{ "scope": ["source.regexp", "string.regexp"], "settings": { "foreground": "#6EE7B7" } },
{ "scope": "string.regexp constant.character.escape", "settings": { "foreground": "#34D399", "fontStyle": "bold" } },
{ "scope": "support.constant", "settings": { "foreground": "#67E8F9" } },
{ "scope": "support.variable", "settings": { "foreground": "#67E8F9" } },
{ "scope": "support.type.property-name.json", "settings": { "foreground": "#5EEAD4" } },
{ "scope": "meta.module-reference", "settings": { "foreground": "#67E8F9" } },
{ "scope": "punctuation.definition.list.begin.markdown", "settings": { "foreground": "#FB923C" } },
{ "scope": ["markup.heading", "markup.heading entity.name"], "settings": { "foreground": "#5EEAD4", "fontStyle": "bold" } },
{ "scope": "markup.quote", "settings": { "foreground": "#34D399" } },
{ "scope": "markup.italic", "settings": { "foreground": "#CBD5E1", "fontStyle": "italic" } },
{ "scope": "markup.bold", "settings": { "foreground": "#CBD5E1", "fontStyle": "bold" } },
{ "scope": "markup.inline.raw", "settings": { "foreground": "#67E8F9" } },
{ "scope": ["markup.deleted", "meta.diff.header.from-file", "punctuation.definition.deleted"], "settings": { "foreground": "#FCA5A5", "background": "#450A0A" } },
{ "scope": ["punctuation.section.embedded"], "settings": { "foreground": "#F472B6" } },
{ "scope": ["markup.inserted", "meta.diff.header.to-file", "punctuation.definition.inserted"], "settings": { "foreground": "#34D399", "background": "#022C22" } },
{ "scope": ["markup.changed", "punctuation.definition.changed"], "settings": { "foreground": "#FBBF24", "background": "#451A03" } },
{ "scope": "meta.diff.range", "settings": { "foreground": "#A78BFA", "fontStyle": "bold" } },
{ "scope": "meta.diff.header", "settings": { "foreground": "#67E8F9" } },
{ "scope": ["brackethighlighter.tag", "brackethighlighter.curly", "brackethighlighter.round", "brackethighlighter.square", "brackethighlighter.angle", "brackethighlighter.quote"], "settings": { "foreground": "#64748B" } },
{ "scope": "brackethighlighter.unmatched", "settings": { "foreground": "#FCA5A5" } },
{ "scope": ["constant.other.reference.link", "string.other.link"], "settings": { "foreground": "#6EE7B7" } },
{ "scope": "token.info-token", "settings": { "foreground": "#38BDF8" } },
{ "scope": "token.warn-token", "settings": { "foreground": "#FBBF24" } },
{ "scope": "token.error-token", "settings": { "foreground": "#F87171" } },
{ "scope": "token.debug-token", "settings": { "foreground": "#A78BFA" } }
